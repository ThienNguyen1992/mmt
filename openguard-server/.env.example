# Môi trường & mạng Server (dev | lab | prod)
APP_ENV=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
CORS_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

# Database (lưu file openguard.db ở thư mục gốc chung openguard-kids/)
DATABASE_URL=sqlite:///../openguard.db

# Khóa mật mã — SINH NGẪU NHIÊN trước khi chạy:
# python -c "import secrets, base64, os; print(secrets.token_hex(32)); print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS
AES_GCM_KEY_B64=CHANGE_ME_BASE64_32_BYTES_KEY
DEVICE_SECRET_PEPPER=CHANGE_ME_RANDOM_64_HEX_CHARS

# Chứng chỉ Ed25519 ký Policy & TLS Server
POLICY_SIGNING_PRIVATE_KEY_PEM_PATH=./certs/policy_ed25519_private.pem
POLICY_SIGNING_PUBLIC_KEY_PEM_PATH=./certs/policy_ed25519_public.pem
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key

# Thời hạn phiên & token (mục 2.3 & F5)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_EXPIRE_HOURS=12
ENROLLMENT_CODE_EXPIRE_MINUTES=10

# Chống brute-force (F5)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Dữ liệu & Offline policy (F3 & OGK-043)
RETENTION_DAYS=90
OFFLINE_FAIL_MODE=fail-closed
OFFLINE_GRACE_DAYS=3
DEVICE_ONLINE_THRESHOLD_SEC=120

# Cookie: false chỉ khi dev HTTP localhost; BẮT BUỘC true khi chạy HTTPS TLS :8443
COOKIE_SECURE=true
